pub fn with_bm25(m: VsMemory, p: VsBm25Params) -> VsMemory []
    todo("vectorstore-nv.vsstore.with_bm25")

// The same store with a fusion of the caller's own.
//
// ```novo
// use vsstore
//
// fn tuned(m: VsMemory, f: VsFusion) -> VsMemory
//     vsstore.with_fusion(m, f)
// ```
pub fn with_fusion(m: VsMemory, f: VsFusion) -> VsMemory []
    todo("vectorstore-nv.vsstore.with_fusion")

// The collection inside, as a value.
//
// **ONLY ON THE LOCAL STORE**, and that asymmetry is the design: a
// value is something a program can copy, compare and write to a file,
// and a server is not one.  A caller that wants this from a remote
// store is asking to download the corpus, which is `vshttp.scroll`
// and says so.
//
// ```novo
// use vsstore
//
// fn value(m: VsMemory) -> VsCollection
//     vsstore.snapshot(m)
// ```
pub fn snapshot(m: VsMemory) -> VsCollection []
    todo("vectorstore-nv.vsstore.snapshot")

// The in-memory store performs nothing.
//
// `[]` on every method — which is the trait's effect parameter
// working, and which is what lets `tests/vsstore_tests.nv` drive a
// whole retrieval pipeline with no row at all.
//
// ```novo ignore
// use vsstore
//
// fn find(m: VsMemory, q: VsQuery) -> Result<VsSearchOutcome, VsFault>
//     m.vs_search(q)
// ```
impl VsStore[] for VsMemory
    fn vs_upsert(self, docs: [VsDoc]) -> Result<Int, VsFault>
        todo("vectorstore-nv.vsstore.VsMemory.vs_upsert")

    fn vs_delete(self, ids: [Str]) -> Result<Int, VsFault>
        todo("vectorstore-nv.vsstore.VsMemory.vs_delete")

    fn vs_get(self, ids: [Str]) -> Result<[VsDoc], VsFault>
        todo("vectorstore-nv.vsstore.VsMemory.vs_get")

    fn vs_search(self, q: VsQuery) -> Result<VsSearchOutcome, VsFault>
        todo("vectorstore-nv.vsstore.VsMemory.vs_search")

    fn vs_count(self) -> Result<Int, VsFault>
        todo("vectorstore-nv.vsstore.VsMemory.vs_count")

// Search any store and answer the documents.
//
// Effect-polymorphic: `[]` over the in-memory store, `[fs]` over a
// file, `[net]` over a server.  The one call an application writes,
// and the reason the trait exists.
//
// ```novo ignore
// use vsstore
//
// fn find(s: VsHttp, q: VsQuery) -> Result<VsDocResults, VsFault> [net]
//     vsstore.retrieve(s, q)
// ```
pub fn retrieve<S: VsStore[e]>(s: S, q: VsQuery) -> Result<VsDocResults, VsFault> [e]
    todo("vectorstore-nv.vsstore.retrieve")

// Insert documents in batches, answering how many landed.
//
// A batch size rather than one call per document, because every remote
// store charges a round trip per request and an ingestion of a hundred
// thousand documents one at a time is hours of latency.  The in-memory
// store ignores the size, and that is fine: the call site is the same.
//
// ```novo ignore
// use vsstore
//
// fn ingest(s: VsHttp, ds: [VsDoc]) -> Result<Int, VsFault> [net]
//     vsstore.ingest(s, ds, 128)
// ```
pub fn ingest<S: VsStore[e]>(s: S, docs: [VsDoc], batch: Int) -> Result<Int, VsFault> [e]
    todo("vectorstore-nv.vsstore.ingest")

// Whether a store can answer this query at all.
//
// Asked through the trait so the refusal is the same sentence locally
// and remotely: a hybrid query against a collection with no keyword
// index is `VsUnsupportedQuery` here and `VsUnsupportedQuery` against
// a server that has no sparse vectors configured.
//
// ```novo ignore
// use vsstore
//
// fn ok(s: VsHttp, q: VsQuery) -> Result<Int, VsFault> [net]
//     vsstore.check_query(s, q)
// ```
pub fn check_query<S: VsStore[e]>(s: S, q: VsQuery) -> Result<Int, VsFault> [e]
    todo("vectorstore-nv.vsstore.check_query")
