// vsvalue_tests.nv — the filter language, the fusion, the collection
// and the two remote dialects, with no socket and no file.
//
use std.test
use std.json
use std.list
use std.math
use std.str
use hnswparam
use vsbm25
use vsdoc
use vsfault
use vsfile
use vsfilter
use vshttp
use vsrank
use vssearch

fn a_config() -> VsConfig
    vsdoc.config(2, HnswCosine, "test-model",
                 hnswparam.default_params(2, HnswCosine)!)

fn a_doc(id: Str, year: Int) -> VsDoc
    vsdoc.with_metadata(vsdoc.doc(id, id, [0.1, 1.0]),
                        json.object([("year", json.int(year))]))

@test
fn test_an_impossible_filter_is_not_an_empty_shelf() [io]
    // "Your filter cannot match anything" and "nothing in the corpus
    // matched" are different answers, and a store that gave the second
    // for the first hides a bug in a query builder.
    test.assert(not vsfilter.is_satisfiable(VsNone))
    test.assert(vsfilter.is_satisfiable(VsAll))

@test
fn test_an_empty_conjunction_and_an_empty_disjunction_are_opposite_answers() [io]
    // So a store that quietly picked one returns either the whole
    // corpus or none of it.  Both are refused.
    match vsfilter.check(vsfilter.all_of([]))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    match vsfilter.check(vsfilter.any_of([]))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_a_comparison_between_two_types_is_refused_rather_than_false() [io]
    // Both remote dialects answer false, which is indistinguishable
    // from "no documents matched".
    let f = vsfilter.is_clause(VsGt("year", VsStr("2020")))
    let meta = json.object([("year", json.int(2021))])

    match vsfilter.matches(f, meta)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_an_empty_in_list_matches_nothing_and_is_refused() [io]
    match vsfilter.check(vsfilter.is_clause(VsIn("lang", [])))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_absent_and_null_are_two_states_with_two_clauses() [io]
    let present = json.object([("year", json.int(2021))])
    let nulled = json.object([("year", json.null())])

    match vsfilter.matches(vsfilter.is_clause(VsExists("year")), present)
        Err(_) => test.assert(false)
        Ok(b)  => test.assert(b)

    match vsfilter.matches(vsfilter.is_clause(VsMissing("year")), nulled)
        Err(_) => test.assert(false)
        Ok(b)  => test.assert(b)

@test
fn test_a_filter_names_its_fields_and_counts_its_clauses() [io]
    let f = vsfilter.all_of([vsfilter.is_clause(VsEq("lang", VsStr("da"))),
                             vsfilter.is_clause(VsGt("year", VsInt(2020)))])

    test.assert(vsfilter.clause_count(f) == 2)
    test.assert(list.len(vsfilter.fields_of(f)) == 2)

@test
fn test_simplifying_a_filter_is_published_because_a_person_reads_it() [io]
    let f = vsfilter.all_of([VsAll, vsfilter.is_clause(VsEq("lang", VsStr("da")))])

    test.assert(vsfilter.clause_count(vsfilter.simplify(f)) == 1)

@test
fn test_a_scalar_crosses_into_the_filter_language_and_back() [io]
    match vsfilter.value_of(json.int(7))
        None    => test.assert(false)
        Some(v) => test.assert(json.type_of(vsfilter.value_json(v)) == "number")

    test.case("an object is not a comparable value, in either dialect")
    match vsfilter.value_of(json.object([]))
        Some(_) => test.assert(false)
        None    => test.assert(true)

    test.case("a boolean and a string are values, carried as themselves")
    match vsfilter.value_of(json.bool(true))
        Some(VsBool(b)) => test.assert(b)
        _               => test.assert(false)
    match vsfilter.value_of(json.string("en"))
        Some(VsStr(s)) => test.assert(s == "en")
        _              => test.assert(false)

@test
fn test_a_metadata_fraction_reaches_a_filter_as_a_fraction() [io]
    // A number read through `json.to_int` is truncated on the compiled
    // leg (4.5 -> 4) where the interpreter answers None, so `score >
    // 4.2` would answer false against a document every remote dialect
    // says true for.  A number carries the text of the number, and the
    // text is what `vsfilter` reads.  Filed as
    // novo/json-get-int-and-to-int-truncate-a-double-where-the-interpreter-answers-none
    let meta = json.object([("score", json.float(4.5)),
                            ("year", json.int(2021))])

    test.case("the fraction survives into the filter language")
    match vsfilter.value_of(json.float(4.5))
        Some(VsFloat(x)) => test.assert_eq(x, 4.5)
        _                => test.assert(false)

    test.case("a whole number is still the integer it was written as")
    match vsfilter.value_of(json.int(4))
        Some(VsInt(n)) => test.assert_eq(n, 4)
        _              => test.assert(false)

    test.case("and a filter compares the number the document holds")
    match vsfilter.matches(vsfilter.is_clause(VsGt("score", VsFloat(4.2))), meta)
        Err(_) => test.assert(false)
        Ok(b)  => test.assert(b)

    match vsfilter.matches(vsfilter.is_clause(VsEq("score", VsFloat(4.5))), meta)
        Err(_) => test.assert(false)
        Ok(b)  => test.assert(b)

@test
fn test_fusion_merges_ranks_and_has_nowhere_to_put_a_score() [io]
    // A BM25 score and a cosine similarity are not on a scale.  The
    // parameter's type is the argument.
    let a = vsrank.ranking(["x", "y", "z"])
    let b = vsrank.ranking(["y", "x"])

    let fused = vsrank.fuse(vsrank.default_fusion(), [a, b])

    test.case("three documents came out")
    test.assert(list.len(fused) == 3)

    match list.first(fused)
        None    => test.assert(false)
        Some(h) =>
            test.case("and the one both lists ranked highly wins")
            test.assert(vsrank.found_in(h) == 2)

@test
fn test_a_document_found_by_both_beats_one_found_first_by_only_one() [io]
    // The property reciprocal rank fusion exists for.
    let a = vsrank.ranking(["only_a", "both"])
    let b = vsrank.ranking(["only_b", "both"])

    match list.first(vsrank.fuse(vsrank.default_fusion(), [a, b]))
        None    => test.assert(false)
        Some(h) => test.assert(h.id == "both")

@test
fn test_the_constant_is_cormack_clarke_and_buettchers() [io]
    // Named as theirs, so a port is checked rather than tuned.
    test.assert(vsrank.default_fusion().k == 60)
    test.assert(vsrank.contribution(vsrank.default_fusion(), 1, 1.0) > 0.0)

@test
fn test_weights_of_the_wrong_length_are_a_silent_misweighting() [io]
    match vsrank.check(vsrank.fusion(60, [1.0]), 2)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_two_retrievers_that_agree_are_one_retriever() [io]
    let a = vsrank.ranking(["x", "y"])
    test.assert(vsrank.overlap(a, a, 2) == 1.0)

@test
fn test_hits_become_a_ranking_and_their_scores_do_not_come_with_them() [io]
    let r = vsrank.of_hits([])
    test.assert(list.len(r.ids) == 0)
    test.assert(list.len(vsrank.take_k([], 10)) == 0)

@test
fn test_bm25_carries_robertson_and_walkers_numbers() [io]
    let p = vsbm25.default_params()

    test.assert(p.k1 == 1.2)
    test.assert(p.b == 0.75)

    test.case("and BM25+ is off, because a port is the thing it ports first")
    test.assert(p.delta == 0.0)

@test
fn test_the_stop_word_list_is_empty_by_default() [io]
    // Every list disagrees with every other, and dropping `not` from a
    // corpus of requirements changes what the corpus says.
    test.assert(list.len(vsbm25.tokenizer().stop_words) == 0)
    test.assert(vsbm25.tokenizer().fold_case)

@test
fn test_tokens_are_unicode_word_boundaries_and_not_a_split_on_spaces() [io]
    // An index that split on ASCII whitespace indexes a Japanese
    // document as one enormous term and matches nothing.
    let t = vsbm25.tokenizer()

    test.assert(list.len(vsbm25.tokenize(t, "the capital of Denmark")) == 4)
    test.assert(list.len(vsbm25.tokenize(t, "デンマークの首都")) > 1)

@test
fn test_an_unknown_term_is_named_rather_than_scoring_everything_zero() [io]
    // "Why did my search return nothing" has three possible answers
    // and an empty result distinguishes none of them.
    let t = vsbm25.tokenizer()

    match vsbm25.build(t, ["the capital of Denmark is Copenhagen"])
        Err(_) => test.assert(false)
        Ok(ix) =>
            test.assert(list.len(vsbm25.unknown_terms(ix, t, "kangaroo")) == 1)
            test.assert(vsbm25.term_count(ix) > 0)
            test.assert(vsbm25.average_length(ix) > 0.0)
            test.assert(vsbm25.doc_frequency(ix, "copenhagen") == 1)
            test.assert(vsbm25.idf(ix, "copenhagen") > 0.0)

@test
fn test_a_keyword_search_ranks_and_scores_separately() [io]
    let t = vsbm25.tokenizer()
    let p = vsbm25.default_params()

    match vsbm25.build(t, ["denmark", "sweden"])
        Err(_) => test.assert(false)
        Ok(ix) =>
            test.assert(list.len(vsbm25.score_all(ix, t, p, "denmark")) == 2)
            test.assert(list.len(vsbm25.top_k(ix, t, p, "denmark", 1)) == 1)

            match vsbm25.add(ix, t, "norway")
                Ok(_)  => test.assert(true)
                Err(_) => test.assert(false)

    test.assert(vsbm25.empty_index().total_len == 0)
    test.assert(vsbm25.params(1.5, 0.75, 0.0).k1 == 1.5)
    test.assert(list.len(vsbm25.with_stop_words(t, ["the"]).stop_words) == 1)

@test
fn test_a_vector_from_another_model_never_reaches_the_index() [io]
    let c = vsdoc.collection("notes", a_config())

    match vsdoc.upsert(c, a_doc("a", 2021), "another-model")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("nor one of the wrong length")
    match vsdoc.check_vector(c, [0.1], "test-model")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_a_batch_says_what_it_replaced() [io]
    // "I inserted a thousand" and "I inserted nine hundred and
    // replaced a hundred" are different facts about a corpus.
    let c = vsdoc.collection("notes", a_config())

    match vsdoc.upsert_many(c, [a_doc("a", 2021), a_doc("a", 2022)], "test-model")
        Err(_) => test.assert(false)
        Ok(u)  =>
            test.assert(u.added == 1)
            test.assert(list.len(u.replaced) == 1)

@test
fn test_a_delete_is_a_mark_and_the_space_is_reclaimed_by_compacting() [io]
    // Worth knowing before somebody deletes personal data.
    var c = vsdoc.collection("notes", a_config())
    match vsdoc.upsert(c, a_doc("a", 2021), "test-model")
        Ok(next) =>
            c = next
        Err(_)   => test.assert(false)

    match vsdoc.delete(c, "a")
        Err(_)   => test.assert(false)
        Ok(next) =>
            test.case("it is gone from the count")
            test.assert(vsdoc.doc_count(next) == 0)

            test.case("and still occupying a slot")
            test.assert(vsdoc.deleted_count(next) == 1)

            match vsdoc.compact(next, [0.5])
                Ok(small) => test.assert(vsdoc.deleted_count(small) == 0)
                Err(_)    => test.assert(false)

@test
fn test_documents_are_fetched_by_id_in_the_order_asked_for() [io]
    var c = vsdoc.collection("notes", a_config())
    match vsdoc.upsert_many(c, [a_doc("a", 2021), a_doc("b", 2022)], "test-model")
        Err(_) => test.assert(false)
        Ok(u)  =>
            c = u.collection

    test.assert(list.len(vsdoc.get_many(c, ["b", "a", "missing"])) == 2)
    test.assert(list.len(vsdoc.ids(c)) == 2)

    match vsdoc.get(c, "a")
        Some(_) => test.assert(true)
        None    => test.assert(false)

@test
fn test_a_document_is_built_by_value() [io]
    let d = vsdoc.with_vector(
                vsdoc.with_metadata(vsdoc.doc("a", "text", []), json.object([])),
                [0.1, 1.0])

    test.assert(d.id == "a")
    test.assert(list.len(d.vector) == 2)
    test.assert(vsdoc.with_keyword_index(a_config()).keyword_index)

@test
fn test_the_file_format_is_bytes_and_the_filesystem_is_separate() [io]
    // So a caller keeping collections in a database column, an object
    // store or a zip entry never touches the `[fs]` row.
    let c = vsdoc.collection("notes", a_config())

    match vsfile.to_bytes(c)
        Err(_) => test.assert(false)
        Ok(b)  =>
            test.assert(vsfile.is_collection(b))

            match vsfile.peek_header(b)
                Err(_) => test.assert(false)
                Ok(h)  =>
                    test.case("and the header records the model")
                    test.assert(h.model == "test-model")
                    test.assert(h.version == 1)

            match vsfile.from_bytes(b)
                Ok(_)  => test.assert(true)
                Err(_) => test.assert(false)

    match vsfile.size_bound(c)
        Ok(n)  => test.assert(n > 0)
        Err(_) => test.assert(false)

    test.assert(list.len(vsfile.supported_versions()) >= 1)

@test
fn test_the_two_dialects_translate_the_same_filter_differently() [io]
    let f = vsfilter.is_clause(VsGt("year", VsInt(2020)))

    match vshttp.encode_filter(VsQdrant, f)
        Ok(v)  => test.assert(json.type_of(v) == "object")
        Err(_) => test.assert(false)

    match vshttp.encode_filter(VsChroma, f)
        Ok(v)  => test.assert(json.type_of(v) == "object")
        Err(_) => test.assert(false)

@test
fn test_chroma_has_no_sparse_vectors_and_says_so_by_name() [io]
    // Rather than a vector search that quietly dropped its keyword
    // half.
    let q = vssearch.hybrid_query([0.1, 1.0], "denmark", 10)

    match vshttp.check_query(VsChroma, q)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_a_string_id_becomes_a_stable_point_id_and_the_original_travels() [io]
    // qdrant accepts an unsigned integer or a UUID and nothing else.
    let a = vshttp.point_id(VsQdrant, "docs/intro.md")
    let b = vshttp.point_id(VsQdrant, "docs/intro.md")

    test.assert(a == b)
    test.assert(vshttp.point_id(VsChroma, "docs/intro.md") == "docs/intro.md")

@test
fn test_a_remote_client_is_built_by_value() [io]
    let c = vshttp.with_model(
                vshttp.with_header(vshttp.qdrant("http://localhost:6333", "notes"),
                                   "api-key", "secret"),
                "test-model")

    test.assert(c.collection == "notes")
    test.assert(list.len(c.headers) == 1)
    test.assert(c.model == "test-model")
    test.assert(vshttp.dialect_name(c.dialect) == "qdrant")
    test.assert(vshttp.search_path(c) != "")
    test.assert(vshttp.upsert_path(c) != "")

    match vshttp.dialect_of_name("chroma")
        Some(d) => test.assert(vshttp.dialect_name(d) == "chroma")
        None    => test.assert(false)

@test
fn test_a_remote_answer_is_read_without_a_socket() [io]
    let c = vshttp.chroma("http://localhost:8000", "notes")

    match vshttp.encode_search(c, vssearch.query([0.1, 1.0], 10))
        Ok(_)  => test.assert(true)
        Err(_) => test.assert(false)

    match vshttp.encode_upsert(c, [a_doc("a", 2021)])
        Ok(_)  => test.assert(true)
        Err(_) => test.assert(false)

    match vshttp.decode_search(c, "{\"ids\":[[]],\"distances\":[[]]}")
        Ok(o)  => test.assert(not o.exhaustive)
        Err(_) => test.assert(true)

    match vshttp.decode_get(c, "{\"ids\":[]}")
        Ok(ds) => test.assert(list.len(ds) == 0)
        Err(_) => test.assert(true)

    test.assert(vsfault.is_retryable(vshttp.decode_error(VsChroma, 503, "")))

@test
fn test_a_fault_says_whether_it_is_the_callers_own() [io]
    test.assert(vsfault.is_caller_error(VsDimMismatch(768, 384)))
    test.assert(not vsfault.is_retryable(VsNoSuchDoc("a")))

@test
fn test_a_token_is_a_word_or_a_number_and_nothing_between() [io]
    // UAX #29 hands back the spaces and the punctuation too; a term is
    // the words and the numbers, and the two rules after that are the
    // empty segment and the minimum length.
    let t = vsbm25.tokenizer()

    test.case("a number is a term")
    test.assert(list.contains(vsbm25.tokenize(t, "the year 2021"), "2021"))

    test.case("an empty segment and a segment under the minimum are dropped")
    test.assert(not vsbm25.kept(t, ""))
    let strict = VsTokenizer { fold_case: true, min_length: 3, stop_words: [] }
    test.assert(not vsbm25.kept(strict, "ab"))
    test.assert(vsbm25.kept(strict, "abc"))

@test
fn test_an_index_that_never_saw_a_term_and_holds_nothing() [io]
    let ix = vsbm25.empty_index()

    test.case("a term that is not in the index occurs zero times")
    test.assert(vsbm25.tf_of(ix, "absent", 0) == 0)

    test.case("an index with no documents has no average length")
    test.assert(vsbm25.average_length(ix) == 0.0)

@test
fn test_every_fault_says_whether_the_caller_caused_it_and_prints_both_sides() [io]
    // A caller retries a transport failure and fixes its own request,
    // and `message` is what a person reads when neither is obvious.
    let mine: [VsFault] = [VsDimMismatch(768, 384), VsModelMismatch("a", "b"),
                           VsNotFinite("x", 2), VsNoSuchDoc("x"), VsDuplicateId("x"),
                           VsBadFilter("f", "why"), VsUnsupportedQuery("what")]
    for f in mine
        test.assert(vsfault.is_caller_error(f))
        test.assert(f.message() != "")

    // The other six are not the caller's to fix: a file that is not a
    // collection, a disk that refused, an index that refused, and
    // whatever the far end said or failed to say.
    let theirs: [VsFault] = [VsBadFile("why"), VsIoFailed("/p", "why"), VsIndexFailed("why"),
                             VsRemoteFailed(404, "code", "why"), VsTransportFailed("why"),
                             VsMalformedReply("what")]
    for f in theirs
        test.assert(not vsfault.is_caller_error(f))
        test.assert(f.message() != "")

@test
fn test_a_fusion_weighs_the_lists_it_names_and_refuses_to_guess() [io]
    let two = vsrank.fusion(10, [1.0, 2.0])

    test.case("a weight the fusion names is the weight it uses")
    test.assert(vsrank.weight_at(two, 1) == 2.0)

    test.case("a list it does not name is worth one")
    test.assert(vsrank.weight_at(two, 2) == 1.0)
    test.assert(vsrank.weight_at(vsrank.default_fusion(), 0) == 1.0)

    test.case("a weighted fusion scores by them")
    let hits = vsrank.fuse(two, [vsrank.ranking(["x", "y"]), vsrank.ranking(["y", "x"])])
    test.assert(list.len(hits) == 2)

    test.case("a weights list that names every list is accepted")
    match vsrank.check(two, 2)
        Ok(k)  => test.assert(k == 10)
        Err(_) => test.assert(false)

    test.case("and one that names some of them is refused rather than guessed")
    match vsrank.check(two, 3)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("two rankings with nothing to share agree on nothing")
    test.assert(vsrank.overlap(vsrank.ranking([]), vsrank.ranking(["a"]), 10) == 0.0)

@test
fn test_the_filter_language_refuses_every_pair_of_types_it_cannot_compare() [io]
    test.case("a field path with an empty segment is not a path")
    test.assert(not vsfilter.is_field_path(""))
    test.assert(not vsfilter.is_field_path("a..b"))
    test.assert(vsfilter.is_field_path("a.b"))

    test.case("a value's type is named so the refusal can print both sides")
    test.assert(vsfilter.value_type_name(VsFloat(1.0)) == "number")
    test.assert(vsfilter.value_type_name(VsBool(true)) == "boolean")

    test.case("a boolean has no order, so an ordering against one is refused")
    match vsfilter.check_orderable("ok", VsBool(true))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match vsfilter.check_orderable("year", VsInt(1))
        Ok(_)  => test.assert(true)
        Err(_) => test.assert(false)

    test.case("equality between two types that are not on one scale")
    match vsfilter.equal_values("f", VsStr("a"), VsInt(1))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match vsfilter.equal_values("f", VsBool(true), VsStr("a"))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match vsfilter.equal_values("f", VsInt(1), VsBool(true))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match vsfilter.equal_values("f", VsFloat(1.0), VsStr("a"))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("and two numbers compare across the two number types")
    match vsfilter.equal_values("f", VsInt(1), VsFloat(1.0))
        Ok(b)  => test.assert(b)
        Err(_) => test.assert(false)

    test.case("ordering is three-way and never invented")
    test.assert(vsfilter.order_floats(1.0, 2.0) < 0)
    test.assert(vsfilter.order_floats(2.0, 1.0) > 0)
    test.assert(vsfilter.order_floats(2.0, 2.0) == 0)
    test.assert(vsfilter.order_ints(2, 1) > 0)
    test.assert(vsfilter.order_strings("a", "b") < 0)
    test.assert(vsfilter.order_strings("b", "a") > 0)
    test.assert(vsfilter.order_strings("a", "a") == 0)

    match vsfilter.order_values("f", VsStr("a"), VsInt(1))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match vsfilter.order_values("f", VsInt(1), VsFloat(2.0))
        Ok(n)  => test.assert(n < 0)
        Err(_) => test.assert(false)
    match vsfilter.order_values("f", VsFloat(2.0), VsInt(1))
        Ok(n)  => test.assert(n > 0)
        Err(_) => test.assert(false)
    match vsfilter.order_values("f", VsFloat(2.0), VsStr("a"))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match vsfilter.order_values("f", VsBool(true), VsInt(1))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_the_types_a_document_can_hold_are_compared_at_their_own_width() [io]
    // The accepting half of the refusals above: the two sides of an
    // equality are compared as the types they are, and the two number
    // types meet each other by value instead of by spelling.
    match vsfilter.equal_values("flag", VsBool(true), VsBool(true))
        Ok(b)  => test.assert(b)
        Err(_) => test.assert(false)
    match vsfilter.equal_values("year", VsInt(2021), VsInt(2021))
        Ok(b)  => test.assert(b)
        Err(_) => test.assert(false)
    match vsfilter.equal_values("score", VsFloat(1.0), VsInt(1))
        Ok(b)  => test.assert(b)
        Err(_) => test.assert(false)

    test.case("two equal integers have no order between them")
    test.assert(vsfilter.order_ints(2, 2) == 0)

    test.case("two strings are ordered byte-lexicographically")
    match vsfilter.order_values("lang", VsStr("da"), VsStr("sv"))
        Ok(n)  => test.assert(n < 0)
        Err(_) => test.assert(false)

    test.case("a clause whose field path is malformed is refused before any document")
    match vsfilter.check_clause(VsEq("a..b", VsInt(1)))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match vsfilter.check_clause(VsEq("a.b", VsInt(1)))
        Ok(_)  => test.assert(true)
        Err(_) => test.assert(false)

    test.case("a field that is not an array holds nothing")
    match vsfilter.array_holds("tags", json.int(1), VsInt(1))
        Ok(b)  => test.assert(not b)
        Err(_) => test.assert(false)

    test.case("and a member that is not a scalar equals nothing")
    let nested = json.array([json.object([("a", json.int(1))]), json.null()])
    match vsfilter.array_holds("tags", nested, VsInt(1))
        Ok(b)  => test.assert(not b)
        Err(_) => test.assert(false)

@test
fn test_the_ways_a_field_can_be_missing_are_all_a_no() [io]
    let meta = json.object([("year", json.int(2021)), ("nulled", json.null())])

    test.case("a field with no member is not there")
    test.assert(not vsfilter.has_field(meta, "absent"))
    test.assert(vsfilter.has_field(meta, "year"))

    test.case("a null and an absent field are one state for a comparison")
    match vsfilter.scalar_at(meta, "nulled")
        None    => test.assert(true)
        Some(_) => test.assert(false)
    match vsfilter.scalar_at(meta, "absent")
        None    => test.assert(true)
        Some(_) => test.assert(false)

    test.case("text is only a string's")
    match vsfilter.text_at(meta, "absent")
        None    => test.assert(true)
        Some(_) => test.assert(false)
    match vsfilter.text_at(meta, "year")
        None    => test.assert(true)
        Some(_) => test.assert(false)
    match vsfilter.text_at(meta, "nulled")
        None    => test.assert(true)
        Some(_) => test.assert(false)

@test
fn test_a_clause_over_a_field_it_cannot_read_answers_false() [io]
    let meta = json.object([("year", json.int(2021)), ("nulled", json.null()),
                            ("tags", json.array([json.string("a"), json.string("b")])),
                            ("mixed", json.array([json.string("a"), json.int(2)]))])

    test.case("a prefix needs a string, and a number has none")
    match vsfilter.eval_clause(VsPrefix("year", "20"), meta)
        Ok(b)  => test.assert(not b)
        Err(_) => test.assert(false)

    match vsfilter.eval_clause(VsPrefix("absent", "20"), meta)
        Ok(b)  => test.assert(not b)
        Err(_) => test.assert(false)

    test.case("contains needs an array, and a null and an absent field are not one")
    match vsfilter.eval_clause(VsContains("nulled", VsInt(1)), meta)
        Ok(b)  => test.assert(not b)
        Err(_) => test.assert(false)

    match vsfilter.eval_clause(VsContains("absent", VsInt(1)), meta)
        Ok(b)  => test.assert(not b)
        Err(_) => test.assert(false)

    test.case("an array holds a member of the same type, and only that")
    match vsfilter.eval_clause(VsContains("tags", VsStr("a")), meta)
        Ok(b)  => test.assert(b)
        Err(_) => test.assert(false)

    match vsfilter.eval_clause(VsContains("tags", VsStr("z")), meta)
        Ok(b)  => test.assert(not b)
        Err(_) => test.assert(false)

    test.case("and a member of another type is the refusal a field of one would be")
    // The no-implicit-coercion rule, one level down: a question about a
    // number is not answered by walking past the strings in the array.
    match vsfilter.eval_clause(VsContains("tags", VsInt(2)), meta)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    match vsfilter.eval_clause(VsContains("mixed", VsInt(2)), meta)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("a comparison against a field that is not there is false, not a fault")
    match vsfilter.eval_clause(VsGt("absent", VsInt(1)), meta)
        Ok(b)  => test.assert(not b)
        Err(_) => test.assert(false)

    test.case("and a clause that is not a comparison has no scalar answer to give")
    match vsfilter.eval_scalar(VsExists("year"), "year", VsInt(2021))
        Ok(b)  => test.assert(not b)
        Err(_) => test.assert(false)

@test
fn test_a_filter_is_simplified_by_what_its_parts_say() [io]
    let c = vsfilter.is_clause(VsEq("lang", VsStr("da")))
    let d = vsfilter.is_clause(VsEq("year", VsInt(2021)))

    test.case("a conjunction with an impossible part is impossible")
    match vsfilter.simplify_and([VsAll, VsNone, c])
        VsNone => test.assert(true)
        _      => test.assert(false)

    test.case("an empty conjunction says nothing")
    match vsfilter.simplify_and([])
        VsAll => test.assert(true)
        _     => test.assert(false)

    test.case("a nested conjunction is flattened")
    match vsfilter.simplify_and([vsfilter.all_of([c, d])])
        VsAnd(parts) => test.assert(list.len(parts) == 2)
        _            => test.assert(false)

    test.case("a disjunction with a part that always holds always holds")
    match vsfilter.simplify_or([VsNone, VsAll, c])
        VsAll => test.assert(true)
        _     => test.assert(false)

    test.case("an empty disjunction says no")
    match vsfilter.simplify_or([VsNone, VsNone])
        VsNone => test.assert(true)
        _      => test.assert(false)

    test.case("a nested disjunction is flattened")
    match vsfilter.simplify_or([vsfilter.any_of([c, d])])
        VsOr(parts) => test.assert(list.len(parts) == 2)
        _           => test.assert(false)

    test.case("and one part alone is that part")
    match vsfilter.simplify_or([c])
        VsIs(_) => test.assert(true)
        _       => test.assert(false)

@test
fn test_a_filter_counts_its_clauses_and_names_its_fields_at_every_depth() [io]
    let c = vsfilter.is_clause(VsEq("lang", VsStr("da")))
    let d = vsfilter.is_clause(VsGt("year", VsInt(2020)))

    test.assert(vsfilter.clause_count(VsAll) == 0)
    test.assert(vsfilter.clause_count(VsNone) == 0)
    test.assert(vsfilter.clause_count(c) == 1)
    test.assert(vsfilter.clause_count(VsNot(VsEq("lang", VsStr("da")))) == 1)
    test.assert(vsfilter.clause_count(vsfilter.any_of([c, d])) == 2)

    test.assert(list.len(vsfilter.fields_of(VsAll)) == 0)
    test.assert(list.len(vsfilter.fields_of(VsNone)) == 0)
    test.assert(list.len(vsfilter.fields_of(VsNot(VsEq("lang", VsStr("da"))))) == 1)
    test.assert(list.len(vsfilter.fields_of(vsfilter.any_of([c, d]))) == 2)

@test
fn test_a_filter_is_satisfiable_exactly_when_some_document_could_match_it() [io]
    let c = vsfilter.is_clause(VsEq("lang", VsStr("da")))

    test.assert(vsfilter.is_satisfiable(c))
    test.assert(vsfilter.is_satisfiable(VsNot(VsEq("lang", VsStr("da")))))
    test.assert(not vsfilter.is_satisfiable(VsNone))
    test.assert(vsfilter.is_satisfiable(vsfilter.all_of([c])))
    test.assert(not vsfilter.is_satisfiable(vsfilter.all_of([c, VsNone])))
    test.assert(vsfilter.is_satisfiable(vsfilter.any_of([VsNone, c])))
    test.assert(not vsfilter.is_satisfiable(vsfilter.any_of([VsNone])))

@test
fn test_a_fraction_crosses_into_json_as_a_fraction() [io]
    // The other direction of the same rule `value_of` reads: a double
    // must not be written as a rounded integer.
    let j = vsfilter.value_json(VsFloat(1.5))

    test.assert(json.type_of(j) == "number")
    match json.to_float(j)
        Some(x) => test.assert(x == 1.5)
        None    => test.assert(false)

@test
fn test_the_marked_list_loses_only_the_id_that_came_back() [io]
    // The id mapping again, one level down: a delete pushes an id onto
    // the marked list and an upsert of that id removes exactly that
    // one.  A rebuild that cleared the whole list would un-mark every
    // other deletion in the collection, and the vectors would be back.
    var c = vsdoc.collection("notes", a_config())
    match vsdoc.upsert_many(c, [vsdoc.doc("a", "denmark", [0.1, 1.0]),
                                vsdoc.doc("b", "sweden", [0.5, 1.0]),
                                vsdoc.doc("c", "norway", [0.9, 1.0])],
                                "test-model")
        Err(_) => test.assert(false)
        Ok(u)  =>
            c = u.collection

    for id in ["a", "b"]
        match vsdoc.delete(c, id)
            Err(_)   => test.assert(false)
            Ok(next) =>
                c = next

    match vsdoc.upsert(c, vsdoc.doc("a", "denmark", [0.1, 1.0]), "test-model")
        Err(_)   => test.assert(false)
        Ok(next) =>
            c = next

    test.assert(vsdoc.deleted_count(c) == 1)
    test.assert(list.len(vsdoc.ids(c)) == 2)
    test.case("and the one that is still marked is 'b'")
    test.assert(list.first(vsdoc.ids(c)) == Some("a"))

@test
fn test_a_batch_stops_at_the_first_document_it_cannot_take() [io]
    // The documents before it are not rolled back and the one that
    // failed is not silently dropped: the caller gets the fault and
    // the forty-nine documents that went in stay in.
    var c = vsdoc.collection("notes", a_config())
    match vsdoc.upsert_many(c, [vsdoc.doc("a", "denmark", [0.1, 1.0]),
                                vsdoc.doc("b", "sweden", [0.5, 1.0, 9.0])],
                                "test-model")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(vsdoc.doc_count(c) == 0)

@test
fn test_a_compact_takes_the_uniforms_the_index_wants_and_reuses_the_named_ones() [io]
    // `compact` rebuilds the graph, so it needs the uniform each insert
    // draws.  A caller that names them gets the same graph twice.
    var c = vsdoc.collection("notes", a_config())
    match vsdoc.upsert_many(c, [vsdoc.doc("a", "denmark", [0.1, 1.0]),
                                vsdoc.doc("b", "sweden", [0.5, 1.0]),
                                vsdoc.doc("c", "norway", [0.9, 1.0])],
                                "test-model")
        Err(_) => test.assert(false)
        Ok(u)  =>
            c = u.collection
    match vsdoc.delete(c, "b")
        Err(_)   => test.assert(false)
        Ok(next) =>
            c = next

    match vsdoc.compact(c, [0.5, 0.25])
        Err(_)      => test.assert(false)
        Ok(smaller) =>
            test.case("the marked document is gone and the live ones are still there")
            test.assert(vsdoc.doc_count(smaller) == 2)
            test.assert(vsdoc.deleted_count(smaller) == 0)

@test
fn test_a_coordinate_that_is_not_a_number_is_refused_in_the_document_s_own_name() [io]
    // A NaN coordinate makes every distance NaN and the document is
    // simply never the nearest — a silent disappearance, so it is
    // caught on the way in and named.
    let c = vsdoc.collection("notes", a_config())

    match vsdoc.upsert(c, vsdoc.doc("b", "sweden", [0.5, math.nan()]), "test-model")
        Ok(_)  => test.assert(false)
        Err(f) =>
            test.case("and the fault names the document and the coordinate")
            test.assert(str.contains(f.message(), "b"))
